flatpak.*

*_build
*_build.*
version.txt
sbom_out/

devcontainer

# Isolated feature worktrees (see .github/scripts/worktree.sh).
# Never track these: a nested .git directory stages as a gitlink and
# silently corrupts history.
.worktrees/

# Scratch checkouts of sibling projectbluefin repos
.common-ref/

# Per-test scratch roots created by the bats unit suite. Tests that abort
# leave theirs behind, and an unsuspecting `git add -A` commits hundreds of
# stub files.
tests/unit/.bats-sandbox/

# Python cache
__pycache__/
*.py[cod]
*$py.class
